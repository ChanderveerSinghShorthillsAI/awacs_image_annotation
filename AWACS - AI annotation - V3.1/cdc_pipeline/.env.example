CDC_MODE=msk

# Environment: "dev" or "prod" — controls which Kafka, DB Fetch API, and DB Update API are used
CDC_ENV=dev

# ===================== DEV CREDENTIALS =====================

# Dev Kafka MSK (via SSM tunnel)
DEV_MSK_BROKERS=broker1:9096,broker2:9096,broker3:9096
DEV_MSK_USERNAME=msk_dev
DEV_MSK_PASSWORD=your_dev_password

# Dev DB API credentials (for CDC pipeline DB fetch & update)
CDC_DB_API_BASE_URL=https://api-dev.traderonline.com/vLatest
CDC_DB_API_CLIENT_ID=your-client-id
CDC_DB_API_CLIENT_SECRET=your-client-secret
CDC_DB_API_GRANT_TYPE=client_credentials

# ===================== PROD CREDENTIALS =====================

# Prod Kafka MSK
PROD_MSK_BROKERS=broker1:9096,broker2:9096,broker3:9096
PROD_MSK_USERNAME=your_prod_msk_user
PROD_MSK_PASSWORD=your_prod_msk_password

# Prod DB API credentials (for CDC pipeline DB fetch & update)
PROD_DB_API_TOKEN_URL=https://nebulous-prod.traderonline.com/vLatest/token
PROD_DB_API_BASE_URL=https://nebulous-prod.traderonline.com/vLatest
PROD_DB_API_UPDATE_BASE_URL=https://nebulous-prod.traderonline.com/vLatest/trucks
PROD_DB_API_CLIENT_ID=your-client-id
PROD_DB_API_CLIENT_SECRET=your-client-secret
PROD_DB_API_GRANT_TYPE=client_credentials
