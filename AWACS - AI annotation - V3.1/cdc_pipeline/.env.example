# CDC Pipeline Environment Variables
# Copy this file to .env and fill in the values.

CDC_MODE=msk

# MSK Kafka Brokers (comma-separated)
DEV_MSK_BROKERS=
MSK_USERNAME=
MSK_PASSWORD=

# Dev DB API credentials (for CDC pipeline DB fetch)
CDC_DB_API_BASE_URL=
CDC_DB_API_CLIENT_ID=
CDC_DB_API_CLIENT_SECRET=
CDC_DB_API_GRANT_TYPE=
