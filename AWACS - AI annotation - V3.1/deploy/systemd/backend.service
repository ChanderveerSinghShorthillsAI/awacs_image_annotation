# /etc/systemd/system/backend.service
# AWACS FastAPI backend — handles /api/cdc-trigger that run_eod posts to.
#
# IMPORTANT: --reload is OFF here. On dev you run `uvicorn main:app --reload`
# so file edits restart the server. On prod that would kill a 10-hour
# annotation run mid-flight if anything touches the source tree. Source on
# this VM should only change via deliberate `git pull` + `systemctl restart`.

[Unit]
Description=AWACS FastAPI backend
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=600
OnFailure=cdc-alert@%n.service

[Service]
Type=simple
User=awacs
WorkingDirectory=/opt/awacs/AWACS - AI annotation - V3.1/backend
EnvironmentFile=/etc/cdc/cdc.env
ExecStart=/opt/awacs/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

# Restart on crash but cap so a sustained failure does not loop.
Restart=on-failure
RestartSec=15

# Backend background tasks can be long-lived (annotation jobs).
# Give SIGTERM 60s to finish in-flight requests before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target