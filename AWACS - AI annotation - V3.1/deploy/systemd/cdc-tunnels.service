# /etc/systemd/system/cdc-tunnels.service
# Brings up the AWS SSM port-forwards to MSK at boot via `make quickstart`
# from the cdc-pipeline-docker repo. RemainAfterExit=yes keeps the unit in
# "active" state once the make target returns so dependents (cdc-consumer)
# can require it without waiting forever.

[Unit]
Description=CDC AWS SSM tunnels to MSK
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitBurst=3
StartLimitIntervalSec=900
OnFailure=cdc-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/cdc-pipeline-docker
ExecStart=/usr/bin/make quickstart
ExecStop=/usr/bin/make ssm-stop
TimeoutStartSec=300
User=awacs

# Cap restart attempts so a sustained AWS outage doesn't infinite-loop us.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
