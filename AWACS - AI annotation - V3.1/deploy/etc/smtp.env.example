# Install path on the VM: /etc/cdc/smtp.env
# Permissions: chmod 600, owned by awacs:awacs.
# Generated from a Gmail account with 2FA enabled — create the app password at
# https://myaccount.google.com/apppasswords and paste the 16-char value below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts-sender@gmail.com
SMTP_PASS=replace-with-16-char-app-password
ALERT_TO=your.recipient@gmail.com
