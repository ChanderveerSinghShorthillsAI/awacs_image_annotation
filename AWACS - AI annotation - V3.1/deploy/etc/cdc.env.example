# Install path on the VM: /etc/cdc/cdc.env
# Permissions: chmod 600, owned by awacs:awacs.
# Loaded by cdc-consumer.service and cdc-annotate.service via EnvironmentFile=.
#
# IMPORTANT: pick CDC_ENV first (dev or prod). Only the matching credential
# block needs values; the other block can stay empty.
#
# This file is the same shape as cdc_pipeline/.env on a developer laptop,
# plus path overrides that point at /var/lib/cdc.

# --- Connection / environment --------------------------------------------
CDC_MODE=msk

# Set to "dev" on the dev VM, "prod" on the prod VM. Drives which MSK
# brokers, DB API, and consumer group the daemon uses (see config.py).
CDC_ENV=dev

# --- Dev MSK creds (used when CDC_ENV=dev) -------------------------------
# Same values your laptop's cdc_pipeline/.env uses for the toldev profile.
DEV_MSK_BROKERS=
DEV_MSK_USERNAME=
DEV_MSK_PASSWORD=

# --- Prod MSK creds (used when CDC_ENV=prod) -----------------------------
PROD_MSK_BROKERS=
PROD_MSK_USERNAME=
PROD_MSK_PASSWORD=

# --- Dev DB API (used when CDC_ENV=dev) ----------------------------------
CDC_DB_API_BASE_URL=
CDC_DB_API_CLIENT_ID=
CDC_DB_API_CLIENT_SECRET=
CDC_DB_API_GRANT_TYPE=client_credentials

# --- Prod DB API (used when CDC_ENV=prod) --------------------------------
PROD_DB_API_TOKEN_URL=https://nebulous-prod.traderonline.com/vLatest/token
PROD_DB_API_BASE_URL=https://nebulous-prod.traderonline.com/vLatest
PROD_DB_API_UPDATE_BASE_URL=https://nebulous-prod.traderonline.com/vLatest/trucks
PROD_DB_API_CLIENT_ID=
PROD_DB_API_CLIENT_SECRET=
PROD_DB_API_GRANT_TYPE=client_credentials

# --- Backend on this VM --------------------------------------------------
CDC_BACKEND_URL=http://localhost:8000

# --- Daemon-mode paths (override the in-repo defaults so they live under /var/lib) ---
CDC_OUTPUT_FILE=/var/lib/cdc/current/filtered_ads.jsonl
CDC_RAW_MESSAGES_FILE=/var/lib/cdc/current/raw_messages.jsonl
CDC_SUMMARY_FILE=/var/lib/cdc/current/session_summary.json
CDC_ROTATED_DIR=/var/lib/cdc/rotated

# --- Optional behavior knobs (defaults are sensible) ---------------------
# CDC_DAEMON_FILE_SOFT_CAP_BYTES=209715200    # 200 MB; halts writes if exceeded
# CDC_EOD_FILE_MAX_BYTES=52428800             # 50 MB; run_eod refuses oversized files
# CDC_EOD_MIN_DISK_FREE_PCT=15
# CDC_SAVE_RAW_MESSAGES=false
# CDC_SHOW_SUMMARY=false